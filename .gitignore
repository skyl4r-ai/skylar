# ENV FILES
.env

# ══════════════════════════════════════════════════
#  Working dirs — NEVER publish weights, corpora, local notes
#  (weight files are ignored above; this also blocks the
#   config.json / tokenizer.json / *.jsonl that surface the dirs)
# ══════════════════════════════════════════════════
/checkpoints/
/checkpoints_*/
/.datasets/
/CLAUDE.md
/START.md
/projects/
/docs/HELPERS.md
/training/train.runpod.sh

# ══════════════════════════════════════════════════
#  Local tooling / agent config — NEVER publish
# ══════════════════════════════════════════════════
/.claude/
/.agents/
/skills-lock.json
/runpodctl

# ══════════════════════════════════════════════════
#  Secrets — defensive (never publish keys/creds; .env already above)
# ══════════════════════════════════════════════════
.env.local
.env.*.local
*.pem
*.key
secrets.*

# ══════════════════════════════════════════════════
#  pip package — separate PyPI deliverable, NOT vendored in this framework repo
# ══════════════════════════════════════════════════
pip-skylar/

# ══════════════════════════════════════════════════
#  motor-generate — local agent workspace, NOT part of the repo
# ══════════════════════════════════════════════════
/motor-generate/
# Evaluation-set texts are private (our corpus or third parties); only their manifests are public
eval/postcutoff_bytes/*.txt
eval/frozen_bytes/*.txt
