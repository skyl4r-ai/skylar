# =================================================================
# One file per run: everything train.sbatch needs. Copy it, fill it, then
#     bash training/slurm/submit.sh my_run.env
# Paths are absolute. Values marked VERIFY are not known before the first login on the cluster.

# ── Slurm ──
ACCOUNT=""                    # VERIFY: the project account (`saldo -b` on Leonardo)
PARTITION="boost_usr_prod"    # Leonardo Booster
QOS=""                        # empty = normal; boost_qos_dbg = 30 min, <=8 nodes (tests)
NODES=8
GPUS_PER_NODE=4
CPUS_PER_TASK=32              # one task per node (torchrun), all the cores of the node
TIME="24:00:00"               # wall time of ONE job; the chain resubmits
JOB_NAME="skylar-990m"
EXCLUDE=""                    # nodes to avoid, e.g. after a hardware fault: "lrdn1234,lrdn5678"
EXTRA_SBATCH=""               # anything else, e.g. "--exclusive"

# ── software ──
REPO="/path/to/skylar"        # a checkout of the framework (the code that runs)
VENV="/path/to/venv"          # python environment with torch, triton, fla, accelerate (build_env.sh)
MODULES=""                    # VERIFY: e.g. "module load cuda/12.x" if the venv needs it; empty = none
CACHE="/path/to/cache"        # torch.compile / Triton caches, kept across jobs (a restart compiles in ~2 min, not 10)
GNUCOBOL=""                   # prefix of build_gnucobol.sh: COBOLEval and the COBOL rewards (one.sbatch)

# ── the run ──
OUT="/path/to/runs/skylar-990m"      # checkpoints, logs, ledger, telemetry
DATA="/path/to/data"                 # tokenized shards (pretokenized_meta.json + shards/)
TRAIN_ARGS="--preset 1B_D --seq_len 8192 --batch_size 1 --grad_accum 4 --lr 1.5e-4 --warmup 2000 --lr_schedule constant --kda_ratio 3:1 --attn_res --attn_res_mode block --attn_res_block_size 8 --gated_norm 16 --attn_out_gate perhead --hidden_act situ_glu --optimizer muon --doc_masking --dropout 0 --compile --max_tokens 200e9 --eval_every 500 --ckpt_every 1000000 --wsm_every_tok 2e9 --wsm_start_tok 140e9 --log_every 10 --ddp_comm bf16 --bpb_set $REPO/eval/postcutoff_bytes --bpb_every_tok 1e9"

# --lr 1.5e-4: Muon peak for ~200B tokens. arXiv 2601.05049 (eq. 6) gives the AdamW optimum for the model size and
# the tokens; on a 146M proxy Muon is flat from 1x to 4x of the AdamW optimum and loses beyond. 1.5e-4 sits inside that
# range both for the formula and for the optimum implied by our 980M run. The optimum falls with the tokens.
# --wsm_start_tok: the merge snapshots (3.9 GB each for the 990M) only in the last ~30% of the run: ~30 snapshots,
# ~117 GB, instead of ~390 GB from the start.
# --bpb_set: a directory of frozen *.txt slices published after the corpus cutoff (the stopping rule). The texts
# are not in the repository, only eval/postcutoff_bytes/manifest.json to rebuild them: fill the directory, or
# drop the two --bpb_ flags (the trainer stops at startup on a directory without slices).

# ── fault tolerance and budget ──
CKPT_EVERY_MIN=30             # <out>/last every 30 minutes: a fault loses at most this much
STOP_MARGIN_MIN=15            # stop and save this long before the job's time limit
WATCHDOG_GRACE_MIN=30         # first heartbeat may take this long (startup + torch.compile)
WATCHDOG_STALL_MIN=15         # afterwards, a heartbeat older than this = hung job: it is killed
CHAIN_MAX=40                  # never more than this many jobs in the chain
BUDGET_GPU_H=1650             # GPU-hour cap for this run (the ledger stops the chain before it)
MAX_STALLED=2                 # jobs in a row without progress before the chain stops (crash loop)

# ── network ──
MASTER_PORT=29500
NCCL_ENV="NCCL_DEBUG=WARN"    # VERIFY on day 1 with preflight.sbatch: the log must show NET/IB
